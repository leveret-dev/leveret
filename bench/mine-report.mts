// Gap report rendering for the bot review miner. Counts and URLs only; never comment text.
import { CATEGORIES, LINE_WINDOW, type LabelRow } from "./mine-labels.mjs";

type Disposition = LabelRow["disposition"];
export interface AuditEntry { url: string; auto: Disposition; label_source: LabelRow["label_source"]; hand: Disposition | null }
export interface Comparison {
  repository: string;
  pull_request: number;
  replay_head: string;
  targets: string[];
  matched: string[];
  status: "complete" | "invalid";
  reason?: string;
}

/** Deterministic PRNG (mulberry32) so samples reproduce from the seed alone. */
export function random(seed: number): () => number {
  let state = seed >>> 0;
  return () => {
    state = (state + 0x6d2b79f5) >>> 0;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export function shuffle<T>(items: T[], next: () => number): T[] {
  const copy = [...items];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(next() * (i + 1));
    [copy[i], copy[j]] = [copy[j]!, copy[i]!];
  }
  return copy;
}

export function auditSample(rows: LabelRow[], seed: number, n = 50): LabelRow[] {
  const eligible = rows.filter((row) => row.disposition !== "notice" && row.duplicate_of === null).sort((a, b) => a.url.localeCompare(b.url));
  return shuffle(eligible, random(seed)).slice(0, n);
}

/** 95% Wilson score interval. */
export function wilson(successes: number, n: number): { low: number; high: number } {
  if (n === 0) return { low: 0, high: 1 };
  const z = 1.96;
  const p = successes / n;
  const denominator = 1 + (z * z) / n;
  const centre = (p + (z * z) / (2 * n)) / denominator;
  const margin = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / denominator;
  return { low: Math.max(0, centre - margin), high: Math.min(1, centre + margin) };
}

const ratio = (part: number, whole: number) => (whole === 0 ? "-" : (part / whole).toFixed(2));
const median = (values: number[]) => {
  if (values.length === 0) return 0;
  const sorted = [...values].sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[middle]! : (sorted[middle - 1]! + sorted[middle]!) / 2;
};
const count = (rows: LabelRow[], disposition: Disposition) => rows.filter((row) => row.disposition === disposition).length;
const prKey = (row: { repository: string; pull_request: number }) => `${row.repository}#${row.pull_request}`;
const groupBy = <T,>(items: T[], key: (item: T) => string) => {
  const groups = new Map<string, T[]>();
  for (const item of items) groups.set(key(item), [...(groups.get(key(item)) ?? []), item]);
  return [...groups.entries()].sort(([a], [b]) => a.localeCompare(b));
};
const near = (a: LabelRow, b: LabelRow) => a.path !== null && a.path === b.path && a.line !== null && b.line !== null && Math.abs(a.line - b.line) <= LINE_WINDOW;

export function renderReport(allRows: LabelRow[], audit: AuditEntry[], comparisons: Comparison[], date: string, languages: Record<string, string | null>): string {
  const rows = allRows.filter((row) => row.duplicate_of === null);
  const findings = rows.filter((row) => row.disposition !== "notice");
  const out = [
    `# Bot review gap analysis (${date})`,
    "",
    "Generated by `npm run bench:mine -- report` from `bench/review-labels.v1.jsonl`. Fork companion duplicates are excluded from every count. Noise rate is rejected ÷ (accepted + rejected); unclear findings are reported separately.",
    "",
    "## 1. Per bot",
    "",
    "| bot | findings | accepted | rejected | unclear | noise rate | median findings per PR | notices |",
    "| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |",
  ];
  for (const [bot, botRows] of groupBy(rows, (row) => row.bot)) {
    const real = botRows.filter((row) => row.disposition !== "notice");
    const accepted = count(real, "accepted");
    const rejected = count(real, "rejected");
    const perPr = groupBy(real, prKey).map(([, items]) => items.length);
    out.push(`| ${bot} | ${real.length} | ${accepted} | ${rejected} | ${count(real, "unclear")} | ${ratio(rejected, accepted + rejected)} | ${median(perPr)} | ${count(botRows, "notice")} |`);
  }

  out.push("", "## 2. Per category", "", "| category | findings | accepted | acceptance rate | findings by bot |", "| --- | ---: | ---: | ---: | --- |");
  for (const category of CATEGORIES) {
    const items = findings.filter((row) => row.category === category);
    if (items.length === 0) continue;
    const accepted = count(items, "accepted");
    const byBot = groupBy(items, (row) => row.bot).map(([bot, list]) => `${bot}: ${list.length}`).join(", ");
    out.push(`| ${category} | ${items.length} | ${accepted} | ${ratio(accepted, accepted + count(items, "rejected"))} | ${byBot} |`);
  }

  out.push("", "## 3. Overlap on PRs reviewed by two or more bots", "", `An accepted finding is unique when no other bot raised a finding on the same PR and path within ±${LINE_WINDOW} lines. This is location-based, not semantic.`, "", "| bot | accepted | unique accepted |", "| --- | ---: | ---: |");
  const shared = new Map(groupBy(findings, prKey).filter(([, items]) => new Set(items.map((row) => row.bot)).size >= 2));
  const overlap = new Map<string, { accepted: number; unique: number }>();
  for (const items of shared.values()) {
    for (const row of items.filter((item) => item.disposition === "accepted")) {
      const entry = overlap.get(row.bot) ?? { accepted: 0, unique: 0 };
      entry.accepted++;
      if (!items.some((other) => other.bot !== row.bot && near(row, other))) entry.unique++;
      overlap.set(row.bot, entry);
    }
  }
  for (const [bot, entry] of [...overlap.entries()].sort(([a], [b]) => a.localeCompare(b))) out.push(`| ${bot} | ${entry.accepted} | ${entry.unique} |`);

  out.push("", "## 4. Per repository", "", "| repository | language | bot | findings | accepted | acceptance rate |", "| --- | --- | --- | ---: | ---: | ---: |");
  for (const [key, items] of groupBy(findings, (row) => `${row.repository}\0${row.bot}`)) {
    const [repository, bot] = key.split("\0");
    const accepted = count(items, "accepted");
    out.push(`| ${repository} | ${languages[repository!] ?? "-"} | ${bot} | ${items.length} | ${accepted} | ${ratio(accepted, accepted + count(items, "rejected"))} |`);
  }

  const complete = comparisons.filter((comparison) => comparison.status === "complete");
  const targets = complete.flatMap((comparison) => comparison.targets);
  const matched = new Set(complete.flatMap((comparison) => comparison.matched));
  const interval = wilson(matched.size, targets.length);
  const byUrl = new Map(rows.map((row) => [row.url, row]));
  const misses = targets.filter((url) => !matched.has(url));
  out.push(
    "", "## 5. Leveret gap", "",
    `Matched ${matched.size}/${targets.length} accepted findings (${ratio(matched.size, targets.length)}, 95% CI [${interval.low.toFixed(2)}, ${interval.high.toFixed(2)}]) over ${complete.length} complete PRs (${comparisons.length - complete.length} invalid).`,
    "", "Misses by category: " + (groupBy(misses, (url) => byUrl.get(url)?.category ?? "unknown").map(([category, list]) => `${category} ${list.length}`).join(", ") || "none"),
    "", ...misses.map((url) => `- ${url}`),
  );

  out.push("", "## 6. Label quality", "", "Hand-audit agreement (entries without a hand label are excluded):", "", "| label source | audited | agreeing | agreement |", "| --- | ---: | ---: | ---: |");
  for (const source of ["mechanical", "judge"] as const) {
    const audited = audit.filter((entry) => entry.label_source === source && entry.hand !== null);
    const agree = audited.filter((entry) => entry.hand === entry.auto).length;
    out.push(`| ${source} | ${audited.length} | ${agree} | ${ratio(agree, audited.length)} |`);
  }
  out.push("", `Findings with an unknown fix signal: ${findings.filter((row) => row.signals.includes("unknown")).length}. Unclear findings: ${count(findings, "unclear")}.`, "");
  return out.join("\n");
}
