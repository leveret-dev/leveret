{
  "name": "leveret",
  "version": "0.1.0",
  "description": "leveret — self-hosted, hybrid engine for private code reviews: per-change static-analysis engine selection, normalized findings, graded filtering, over MCP.",
  "type": "module",
  "bin": {
    "leveret": "dist/server.js",
    "leveret-app": "dist/app/server.js",
    "leveret-audit": "dist/audit-inspect.js",
    "leveret-runner-pi": "dist/runner/pi.js",
    "leveret-prefetch-serena": "dist/runner/prefetch-serena.js"
  },
  "scripts": {
    "bench:replay": "tsx bench/replay.mts",
    "bench:experiment-plan": "tsx bench/replay.mts --plan",
    "bench:replay-scan": "tsx bench/replay-scan.mts",
    "bench:report": "tsx bench/report.mts",
    "bench:parity": "tsx bench/parity.mts",
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "test": "vitest run"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "octokit": "^5.0.5",
    "typebox": "1.3.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
