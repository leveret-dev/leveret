# ── Gradle / Kotlin build output ─────────────────────────────────────────────
# Trailing-slash-only patterns match at every depth, so runtime/build/ and any
# future module's build directory are covered without repeating them.
.gradle/
.kotlin/
build/
*.class

# ── Knowledge graphs ─────────────────────────────────────────────────────────
# Graphify rules copied from pfBlockerNG. The graph itself is committed so a
# fresh clone can query it without a rebuild; everything else in graphify-out/
# is regenerated locally.
*.graphify-bak
graphify-out/*
!graphify-out/graph.json
# Records accumulate across tickets, so they outlive the worktree that wrote them. The
# re-include names the DIRECTORY on purpose — contract pinned by test_cross_agent_tooling.
!graphify-out/memory/

# CodeGraph's index is per-machine; .codegraph/ carries its own ignore file.

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
